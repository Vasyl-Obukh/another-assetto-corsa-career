{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    // Nothing is emitted: electron-vite bundles main and preload, and imports
    // keep their .ts extensions, as Node itself would need to run src/core.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  // The renderer is a separate project (DOM lib, JSX) at src/renderer/tsconfig.json.
  "include": [
    "eslint.config.js",
    "electron.vite.config.ts",
    "src/core/**/*.ts",
    "src/shared/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts"
  ]
}
