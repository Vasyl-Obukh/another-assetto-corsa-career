{
  "name": "ac-career-mode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Career mode for Assetto Corsa, driving races through Content Manager",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "scan": "node --experimental-transform-types spike.ts scan",
    "dry": "node --experimental-transform-types spike.ts dry",
    "race": "node --experimental-transform-types spike.ts run",
    "watch": "node --experimental-transform-types spike.ts watch",
    "results": "node --experimental-transform-types spike.ts results",
    "weekend": "node --experimental-transform-types spike.ts weekend",
    "series": "node --experimental-transform-types spike.ts series",
    "weather": "node --experimental-transform-types spike.ts weather",
    "testmode": "node --experimental-transform-types spike.ts testmode",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit && tsc -p src/renderer --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "43.4.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.2.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "i18next": "26.3.6",
    "jest": "30.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router": "8.3.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "electron@43.4.0": true
  }
}
